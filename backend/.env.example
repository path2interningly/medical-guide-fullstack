# Database - Point to same Supabase as personal-dashboard
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"

# Authentication
AUTH_PASSWORD=changeme123
JWT_SECRET=your-very-secure-jwt-secret-key-change-this-in-production

# AI provider keys (backend only; set at least one)
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o"
OPENAI_MODEL="gpt-4o"

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
